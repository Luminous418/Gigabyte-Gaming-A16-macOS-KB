def main():
    parser = argparse.ArgumentParser(
        description="Control GIGABYTE GAMING A16 RGB keyboard on macOS "
                    "(HID LampArray via IOKit)"
    )
    parser.add_argument("--debug", action="store_true",
                        help="show every feature report attempt and device props")
    parser.add_argument("--wait", type=float, default=0.0, metavar="SECONDS",
                        help="retry device detection for up to SECONDS (use at "
                             "login, when USB may not be ready yet)")
    sub = parser.add_subparsers(dest="command", required=True)

    p_detect = sub.add_parser("detect", help="print detected VID/PID, or list devices")
    p_detect.add_argument("--list", action="store_true",
                          help="list all HID devices")
    p_detect.add_argument("--gigabyte-only", action="store_true",
                          help="with --list, only show GIGABYTE devices")

    sub.add_parser("info", help="show lamp array attributes (read-only)")
    sub.add_parser("selftest", help="verify read/write on control report (reversible)")
    sub.add_parser("on", help="turn backlight on (white, full)")
    sub.add_parser("off", help="turn backlight off")
    sub.add_parser("auto", help="enable autonomous (firmware) mode, Fn+Space works")
    sub.add_parser("startup", help="apply fixed startup color (default 00aaff)")

    p_restore = sub.add_parser("restore", help="restore last saved color")
    p_restore.add_argument("--auto", action="store_true",
                           help="also enable autonomous mode")

    p_color = sub.add_parser("color", help="set solid color (RRGGBB)")
    p_color.add_argument("color", help="hex color, e.g. ffffff")
    p_color.add_argument("--intensity", type=int, default=DEFAULT_INTENSITY,
                         help="brightness 0-255 (default 255); emulated via RGB scaling")
    p_color.add_argument("--auto", action="store_true",
                         help="after setting the color, enable autonomous mode")

    args = parser.parse_args()
    handler = {
        "detect": cmd_detect,
        "info": cmd_info,
        "selftest": cmd_selftest,
        "on": cmd_on,
        "off": cmd_off,
        "color": cmd_color,
        "restore": cmd_restore,
        "auto": cmd_auto,
        "startup": cmd_startup,
    }[args.command]
    handler(args)


if __name__ == "__main__":
    main()
