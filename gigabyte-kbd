def cmd_detect(args):
    if not args.list:
        vid, pid = _wanted_ids()
        kb = LampArray(vid, pid, wait=getattr(args, "wait", 0))
        try:
            print("{:04x} {:04x}".format(vid, _prop_int(kb.dev, "ProductID") or 0))
        finally:
            kb.close()
        return

    print("{:<12} {:<8} {:<8} {:<8} {:<10} {}".format(
        "RegistryID", "VID", "PID", "UsagePg", "Usage", "Product"))
    print("-" * 72)
    any_found = False
    for dev, service in iter_hid_devices():
        vid = _prop_int(dev, "VendorID") or 0
        pid = _prop_int(dev, "ProductID") or 0
        up = _prop_int(dev, "PrimaryUsagePage")
        us = _prop_int(dev, "PrimaryUsage")
        product = _prop_str(dev, "Product") or ""
        is_ours = (
            vid == VENDOR_ID
            and up == LAMPARRAY_USAGE_PAGE
            and us == LAMPARRAY_USAGE
        )
        if args.gigabyte_only and vid != VENDOR_ID:
            continue
        any_found = True
        print("{:<12} 0x{:<6x} 0x{:<6x} {:<8} {:<10} {}{}".format(
            "0x{:x}".format(service), vid, pid,
            "0x{:x}".format(up) if up is not None else "-",
            us if us is not None else "-",
            product, "   <== LampArray" if is_ours else ""))
    if not any_found:
        print("(no HID devices matched)")


def cmd_info(args):
    vid, pid = _wanted_ids()
    with LampArray(vid, pid, verbose=args.debug, wait=getattr(args, "wait", 0)) as kb:
        attrs = kb.attributes(verbose=args.debug)
        kind = LAMP_KINDS.get(attrs["kind"], "Unknown")
        print("Device:       {:04x}:{:04x} {}".format(
            vid,
            _prop_int(kb.dev, "ProductID") or 0,
            _prop_str(kb.dev, "Product") or "",
        ))
        print("Transport:    {}".format(
            _prop_str(kb.dev, "Transport") or "unknown"))
        print("Lamp count:   {}".format(attrs["lamp_count"]))
        print("Kind:         {} ({})".format(kind, attrs["kind"]))
        print("Bounding box: {}x{}x{} um".format(
            attrs["width"], attrs["height"], attrs["depth"]))
        print("Min interval: {} us".format(attrs["min_interval"]))

        if args.debug:
            for key in ("MaxFeatureReportSize", "MaxInputReportSize",
                        "MaxOutputReportSize", "VendorIDSource"):
                val = _prop_int(kb.dev, key)
                print("  {} = {}".format(key, val))
            desc = _prop_data(kb.dev, "ReportDescriptor")
            if desc:
                print("  ReportDescriptor ({} bytes): {}".format(
                    len(desc), desc[:24].hex()))


def cmd_selftest(args):
    """Read-only diagnostics plus a check of which report types the firmware
    actually answers. Writes nothing."""
    vid, pid = _wanted_ids()
    kb = LampArray(vid, pid, verbose=args.debug, wait=getattr(args, "wait", 0)).open()
    try:
        print("1. LampArrayAttributes (report 0x01)")
        attrs = kb.attributes(verbose=args.debug)
        print("     LampCount    = {}".format(attrs["lamp_count"]))
        print("     Kind         = {} ({})".format(
            LAMP_KINDS.get(attrs["kind"], "Unknown"), attrs["kind"]))
        print("     Bounding box = {}x{}x{} um".format(
            attrs["width"], attrs["height"], attrs["depth"]))
        print("     Min interval = {} us".format(attrs["min_interval"]))
        if attrs["lamp_count"] == 0:
            sys.exit("Error: device reports LampCount=0")

        print("2. LampArrayControl (report 0x06) - GET support")
        try:
            cur = kb.get_autonomous()
            print("     readable, AutonomousMode = {}".format(cur))
        except RuntimeError as exc:
            print("     not readable: {}".format(exc))
            print("     (normal: many LampArray firmwares implement 0x06 as "
                  "write-only)")

        print("3. write path")
        print("     SetReport is attempted by 'on' / 'color'. Buffer convention "
              "is auto-detected.")
        if kb.set_convention:
            print("     forced via GIGABYTE_KBD_CONVENTION = {}".format(
                kb.set_convention))
        print()
        print("RESULT: reads work, device is controllable.")
        print("Next: run 'gigabyte-kbd on' and look at the keyboard.")
    finally:
        kb.close()


def cmd_color(args):
    r, g, b, hexc = parse_color(args.color)
    vid, pid = _wanted_ids()
    with LampArray(vid, pid, verbose=args.debug, wait=getattr(args, "wait", 0)) as kb:
        count = max(kb.attributes()["lamp_count"], 1)
        try:
            kb.set_color_and_auto(r, g, b, args.intensity, count, args.auto)
        except RuntimeError as exc:
            sys.exit("Error: {}".format(exc))
        write_config(hexc, args.intensity)
        mode = "autonomous (Fn+Space works)" if args.auto else "host mode"
        print("Set color #{} intensity={} ({}) on {} lamp(s)".format(
            hexc, args.intensity, mode, count))


def cmd_on(args):
    ns = argparse.Namespace(color=DEFAULT_COLOR,
                            intensity=DEFAULT_INTENSITY,
                            auto=False, debug=getattr(args, "debug", False))
    cmd_color(ns)


