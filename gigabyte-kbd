def read_config():
    cfg = {
        "color": DEFAULT_COLOR,
        "intensity": str(DEFAULT_INTENSITY),
        "startup_color": STARTUP_COLOR,
        "startup_intensity": str(STARTUP_INTENSITY),
        "vendor_id": "{:04x}".format(VENDOR_ID),
        "product_id": "",
    }
    try:
        with open(CONFIG_PATH) as fh:
            for line in fh:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    except OSError:
        pass
    if os.environ.get("GIGABYTE_KBD_VID"):
        cfg["vendor_id"] = os.environ["GIGABYTE_KBD_VID"]
    if os.environ.get("GIGABYTE_KBD_PID"):
        cfg["product_id"] = os.environ["GIGABYTE_KBD_PID"]
    return cfg


def write_config(color, intensity, startup_color=None, startup_intensity=None):
    directory = os.path.dirname(CONFIG_PATH)
    if directory:
        os.makedirs(directory, exist_ok=True)
    cfg = read_config()
    with open(CONFIG_PATH, "w") as fh:
        fh.write("# GIGABYTE GAMING A16 keyboard backlight (macOS)\n")
        fh.write("vendor_id={}\n".format(cfg.get("vendor_id") or "0414"))
        fh.write("product_id={}\n".format(cfg.get("product_id", "")))
        fh.write("color={}\n".format(color))
        fh.write("intensity={}\n".format(intensity))
        fh.write("startup_color={}\n".format(
            startup_color if startup_color is not None else STARTUP_COLOR))
        fh.write("startup_intensity={}\n".format(
            startup_intensity
            if startup_intensity is not None
            else STARTUP_INTENSITY))


def parse_color(hexc):
    hexc = hexc.lstrip("#").lower()
    if len(hexc) != 6:
        sys.exit("Error: color must be RRGGBB (e.g. ffffff)")
    try:
        return (int(hexc[0:2], 16), int(hexc[2:4], 16),
                int(hexc[4:6], 16), hexc)
    except ValueError:
        sys.exit("Error: color must be hexadecimal (e.g. ffffff)")


